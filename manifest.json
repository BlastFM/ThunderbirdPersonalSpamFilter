{
  "manifest_version": 2,
  "name": "Thunderbird OpenAI Spam Detector",
  "version": "1.0",
  "description": "An AI-powered spam detection extension for Thunderbird using OpenAI.",
  "permissions": [
    "activeTab",
    "storage",
    "mail",
    "tabs",
    "notifications",
    "contextMenus",
    "api.openai.com"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://api.openai.com/v1/*"
  ]
}